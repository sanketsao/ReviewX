# Copy this file to .env and fill in the values.

# Required: password for the bundled Postgres container.
# Skip if using docker-compose.external-pg.yml (set DATABASE_URL instead).
POSTGRES_PASSWORD=change-me-strong-password

# Required: secret token for admin operations (resolve, delete, export).
# Generate: openssl rand -hex 16
REVIEWX_ADMIN_TOKEN=change-me-admin-token

# Optional: port the inbox listens on externally (default 4400).
# PORT=4400

# Optional: HS256 secret for JWT auth on multi-user setups.
# Generate: openssl rand -hex 32
# REVIEWX_JWT_SECRET=

# External Postgres only (when using docker-compose.external-pg.yml):
# DATABASE_URL=postgres://user:pass@your-host:5432/reviewsx
