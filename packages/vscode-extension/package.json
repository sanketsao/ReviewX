{
  "name": "protofeedback-vscode",
  "displayName": "ReviewSX",
  "version": "0.1.0",
  "description": "Add a live feedback overlay to any prototype — tour, comments, and publish to GitHub Pages",
  "publisher": "protofeedback",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sanketsao/ReviewSX.git"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "protofeedback.start",
        "title": "ReviewSX: Start prototype with overlay",
        "icon": "$(play)"
      },
      {
        "command": "protofeedback.share",
        "title": "ReviewSX: Share via Tailscale Funnel",
        "icon": "$(broadcast)"
      },
      {
        "command": "protofeedback.publish",
        "title": "ReviewSX: Publish to GitHub Pages",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "protofeedback.stop",
        "title": "ReviewSX: Stop"
      },
      {
        "command": "protofeedback.editTour",
        "title": "ReviewSX: Edit tour"
      },
      {
        "command": "protofeedback.refresh",
        "title": "ReviewSX: Refresh feedback",
        "icon": "$(refresh)"
      },
      {
        "command": "protofeedback.resolveItem",
        "title": "Toggle resolved",
        "icon": "$(check)"
      },
      {
        "command": "protofeedback.setupInbox",
        "title": "ReviewSX: Set up shared inbox",
        "icon": "$(server)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "protofeedback",
          "title": "ReviewSX",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "protofeedback": [
        {
          "id": "protofeedback.feedback",
          "name": "Feedback"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "protofeedback.feedback",
        "contents": "Welcome to ReviewSX.\n\nPreview your prototype with a live overlay — author a guided tour, pin feedback, then publish for your team to review.\n\n[$(play) Start with overlay](command:protofeedback.start)\n\nReady to share?\n[$(cloud-upload) Publish to GitHub Pages](command:protofeedback.publish)\n\n*Requires a public GitHub repo (free) or GitHub Pro/Team for private repos.*",
        "when": "!protofeedback.serverRunning"
      },
      {
        "view": "protofeedback.feedback",
        "contents": "Overlay is running.\n\nOpen your prototype in a browser and click any element to leave feedback.\n\n[$(broadcast) Share via Tailscale Funnel](command:protofeedback.share)\n\n[$(server) Set up shared inbox](command:protofeedback.setupInbox)",
        "when": "protofeedback.serverRunning"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "protofeedback.refresh",
          "when": "view == protofeedback.feedback",
          "group": "navigation"
        },
        {
          "command": "protofeedback.share",
          "when": "view == protofeedback.feedback && protofeedback.serverRunning",
          "group": "navigation"
        },
        {
          "command": "protofeedback.setupInbox",
          "when": "view == protofeedback.feedback",
          "group": "navigation"
        },
        {
          "command": "protofeedback.publish",
          "when": "view == protofeedback.feedback",
          "group": "navigation"
        },
        {
          "command": "protofeedback.start",
          "when": "view == protofeedback.feedback && !protofeedback.serverRunning",
          "group": "navigation"
        },
        {
          "command": "protofeedback.stop",
          "when": "view == protofeedback.feedback && protofeedback.serverRunning",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "protofeedback.resolveItem",
          "when": "view == protofeedback.feedback && viewItem == feedbackItem",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "bundle": "esbuild src/extension.ts --bundle --external:vscode --external:node:sqlite --platform=node --outfile=out/extension.js --sourcemap",
    "package": "npm run bundle && node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});fs.copyFileSync('../../packages/overlay/dist/reviewsx.js','dist/reviewsx.js');fs.copyFileSync('../../packages/overlay/dist/overlay.js','dist/overlay.js')\" && node build-vsix.mjs"
  },
  "dependencies": {
    "@protofeedback/server": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.24.0"
  }
}
